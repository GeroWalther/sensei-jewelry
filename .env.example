# MongoDB Atlas connection string (or local mongodb://localhost:27017/sensei-shop)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/sensei-shop?retryWrites=true&w=majority

# Site URL — used in emails and Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen --forward-to localhost:3000/webhooks/stripe`

# Resend — get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev   # use a verified sender in production

# Admin HTTP Basic Auth (gates /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
